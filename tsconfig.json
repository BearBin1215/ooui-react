{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "esModuleInterop": true,
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "paths": {
      "ooui-react": [
        "./src/index.ts"
      ],
      "ooui-react/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src",
    "playground",
    "vite.config.ts",
    "vitest.config.ts",
    "tsdown.config.ts",
    "vitest.browser-setup.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
